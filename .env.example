# Runtime
TRADING_MODE=paper
PORT=3000
LOG_LEVEL=info
# Safety limits for background API work. Snapshots default to every 5 minutes.
DISCOVERY_INTERVAL_SECONDS=60
SNAPSHOT_INTERVAL_SECONDS=300
MOMENTUM_INTERVAL_SECONDS=300
# Risk checks use two Birdeye calls plus a small top-holder Helius sample.
RISK_INTERVAL_SECONDS=300
MAX_RISK_CHECKS_PER_CYCLE=1
SIGNAL_INTERVAL_SECONDS=60
SNAPSHOT_MAX_CONCURRENCY=1
SNAPSHOT_REQUEST_SPACING_SECONDS=2

# Paper portfolio (all percentages are whole numbers, for example 1 = 1%)
STARTING_BALANCE_SOL=10
RISK_PER_TRADE_PCT=1
MAX_CONCURRENT_POSITIONS=3
MAX_MONITORED_TOKENS=20
PRELIMINARY_MIN_LIQUIDITY_USD=500
MAX_PORTFOLIO_RISK_PCT=3
MAX_DAILY_DRAWDOWN_PCT=5
MAX_ACCOUNT_DRAWDOWN_PCT=15
# 0 = lowest observed risk, 100 = highest. Future paper signals must be at or below this.
MAX_RISK_SCORE=55
MIN_MOMENTUM_SCORE=70

# Storage. The foundation ships with a PostgreSQL migration but does not connect
# to a database until the next milestone.
STORAGE_DRIVER=memory
# When Docker PostgreSQL is running, set STORAGE_DRIVER=postgres and use:
# DATABASE_URL=postgresql://scout:scout_local_password@127.0.0.1:55432/pump_momentum_scout
DATABASE_URL=

# Optional until their provider adapters are implemented.
HELIUS_API_KEY=
BIRDEYE_API_KEY=
