{
  "name": "kairo",
  "version": "0.1.0",
  "private": true,
  "description": "KAIRO — independent Solana Pump.fun paper-trading research engine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/index.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "verify:birdeye": "npm run build && node --env-file=.env dist/src/tools/verify-birdeye.js",
    "db:migrate": "npm run build && node --env-file=.env dist/src/tools/migrate.js",
    "verify:postgres": "npm run build && node --env-file=.env dist/src/tools/verify-postgres.js",
    "discover:once": "npm run build && node --env-file=.env dist/src/tools/discover-once.js",
    "verify:mayhem": "npm run build && node --env-file=.env dist/src/tools/verify-mayhem.js",
    "monitor:once": "npm run build && node --env-file=.env dist/src/tools/monitor-once.js",
    "momentum:once": "npm run build && node --env-file=.env dist/src/tools/momentum-once.js",
    "verify:risk-data": "npm run build && node --env-file=.env dist/src/tools/verify-risk-data.js",
    "verify:holder-profile": "npm run build && node --env-file=.env dist/src/tools/verify-holder-profile.js",
    "verify:fresh-wallets": "npm run build && node --env-file=.env dist/src/tools/verify-fresh-wallets.js",
    "risk:once": "npm run build && node --env-file=.env dist/src/tools/risk-once.js",
    "signal:once": "npm run build && node --env-file=.env dist/src/tools/signal-once.js",
    "signals:recent": "npm run build && node --env-file=.env dist/src/tools/signals-recent.js",
    "prune:inactive": "npm run build && node --env-file=.env dist/src/tools/prune-inactive.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
